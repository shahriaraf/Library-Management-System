{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://library-management-system-neon-xi.vercel.app/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://library-management-system-neon-xi.vercel.app/uploads/:path*"
    },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}